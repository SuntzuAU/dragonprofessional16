---
// This URL was renamed. Redirecting to the canonical long-tail URL.
// Cloudflare Pages serves this as a static HTML page with meta-refresh + canonical.
const newUrl = "/dragon-medical-one-vs-dragon-professional-16";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${newUrl}`} />
    <link rel="canonical" href={`https://dragonprofessional16.com.au${newUrl}`} />
    <title>Redirecting...</title>
    <meta name="robots" content="noindex" />
    <script define:vars={{ newUrl }}>
      window.location.replace(newUrl);
    </script>
  </head>
  <body>
    <p>This page has moved. <a href={newUrl}>Click here if you are not redirected automatically</a>.</p>
  </body>
</html>
