---
import site from "../site.config.json";
import ACForm from "../components/ACForm.astro";

const c = site.colours;
const year = new Date().getFullYear();

// Helper: prefix anchor-only links with / for nav
function homeUrl(url) {
  if (!url) return "/";
  return url.startsWith("#") ? `/${url}` : url;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dragon Professional 16 - Full Feature Comparison | All Versions | VRA Australia</title>
    <meta name="description" content="Compare all Dragon Professional 16 versions side by side - perpetual, upgrade, subscription, student, and enterprise. Full feature matrix including offline use, PC limits, NMC support, and pricing. Voice Recognition Australia." />
    <link rel="canonical" href={`${site.domain}/comparison`} />

    {site.googleAnalyticsId && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAnalyticsId}`}></script>
      <script define:vars={{ gaId: site.googleAnalyticsId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    )}

    <script define:vars={{ c }}>
      const css = `
        body { background: ${c.background}; color: ${c.text}; }
        .btn-primary { background: ${c.accent}; border-color: ${c.accent}; color: #fff; }
        .btn-primary:hover { background: ${c.accentHover}; border-color: ${c.accentHover}; }
        .btn-secondary { color: ${c.primary}; border-color: #cbd5e1; }
        .neutral-bg { background: ${c.neutral}; }
        .dark-bg { background: ${c.primary}; color: white; }
        .nav-links a:hover, .dropdown-toggle:hover { color: ${c.accent}; }
        .dropdown-menu { border-top: 2px solid ${c.accent}; }
        .check { color: ${c.accent}; }
        .col-head { background: ${c.primary}; color: white; }
        .col-head.featured { background: ${c.accent}; }
        .section-head td { background: #f1f5f9; color: ${c.primary}; font-weight: 700; }
        .vs-head { background: ${c.primary}; color: white; }
        .price-row td { font-weight: 800; color: ${c.accent}; font-size: 18px; }
        .cta-cell a { background: ${c.accent}; color: #fff; }
        .cta-cell a:hover { background: ${c.accentHover}; }
      `;
      const el = document.createElement('style');
      el.textContent = css;
      document.head.appendChild(el);
    </script>

    <style is:inline>
      *,*::before,*::after{box-sizing:border-box}
      body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;line-height:1.6}
      a{color:inherit;text-decoration:none}
      img{max-width:100%;display:block}
      .wrap{max-width:1100px;margin:0 auto;padding:0 24px}
      header{position:sticky;top:0;background:rgba(255,255,255,.97);backdrop-filter:blur(12px);border-bottom:1px solid #e2e8f0;z-index:100}
      .nav{display:flex;align-items:center;justify-content:space-between;padding:10px 0;gap:16px}
      .logo img{height:40px;width:auto}
      .nav-links{display:flex;gap:18px;font-size:14px;font-weight:500;color:#334155;align-items:center}
      .nav-links a{white-space:nowrap}
      .dropdown{position:relative}
      .dropdown-toggle{cursor:pointer;display:flex;align-items:center;gap:4px;white-space:nowrap}
      .dropdown-toggle svg{transition:transform .15s}
      .dropdown:hover .dropdown-toggle svg{transform:rotate(180deg)}
      .dropdown-menu{display:none;position:absolute;top:100%;left:0;background:#fff;border:1px solid #e2e8f0;border-radius:10px;box-shadow:0 8px 32px rgba(0,0,0,.1);min-width:220px;padding:8px 0 6px;z-index:200}
      .dropdown:hover .dropdown-menu{display:block}
      .dropdown-menu a{display:block;padding:10px 16px;font-size:14px;font-weight:500;color:#334155;transition:background .1s}
      .dropdown-menu a:hover{background:#fef2f2;color:#CC0000}
      .nav-ctas{display:flex;gap:10px;align-items:center;flex-shrink:0}
      .btn{display:inline-block;padding:10px 20px;border-radius:8px;font-weight:700;font-size:14px;border:2px solid transparent;cursor:pointer;transition:all .15s;white-space:nowrap}
      .btn-secondary{background:white;border-color:#cbd5e1}
      .btn-lg{padding:14px 28px;font-size:16px;border-radius:10px}
      .hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:6px;background:none;border:none}
      .hamburger span{display:block;width:22px;height:2px;background:#334155;border-radius:2px}
      .mobile-nav{display:none;padding:12px 0 8px;border-top:1px solid #e2e8f0}
      .mobile-nav a{display:block;padding:10px 0;font-size:15px;font-weight:500;color:#334155;border-bottom:1px solid #f1f5f9}
      section{padding:56px 0}
      .page-hero{padding:40px 0 32px;border-bottom:1px solid #e2e8f0}
      .breadcrumb{font-size:13px;color:#64748b;margin-bottom:12px}
      .breadcrumb a{color:#CC0000;font-weight:500}
      .page-hero h1{font-size:36px;line-height:1.1;margin:0 0 10px;letter-spacing:-0.03em}
      .page-hero p{font-size:16px;color:#475569;margin:0;max-width:680px}

      /* Main comparison table */
      .table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;border-radius:16px;border:1px solid #e2e8f0;margin-top:32px}
      table{width:100%;border-collapse:collapse;min-width:700px}
      th,td{padding:12px 14px;font-size:14px;border-bottom:1px solid #f1f5f9;text-align:left;vertical-align:middle}
      th{font-weight:700}
      .col-head{padding:16px 14px;font-size:13px;font-weight:700;text-align:center;vertical-align:bottom}
      .feature-col{width:30%;font-size:14px;color:#334155;font-weight:500}
      .val-col{text-align:center;font-size:14px;color:#475569}
      .section-head td{padding:10px 14px;font-size:12px;letter-spacing:.06em;text-transform:uppercase;border-bottom:1px solid #e2e8f0}
      .check{font-size:18px;font-weight:900}
      .cross{color:#94a3b8;font-size:16px}
      .partial{color:#f59e0b;font-size:14px;font-weight:600}
      .note{font-size:11px;color:#94a3b8;display:block;margin-top:2px}
      .price-row td{padding:16px 14px;border-top:2px solid #e2e8f0}
      .cta-cell{text-align:center;padding:12px 8px}
      .cta-cell a{display:inline-block;padding:8px 14px;border-radius:8px;font-size:13px;font-weight:700;transition:background .15s;white-space:nowrap}

      /* vs section */
      .vs-table-wrap{overflow-x:auto;border-radius:16px;border:1px solid #e2e8f0;margin-top:24px}
      .vs-head td{padding:14px;font-size:14px;font-weight:700;text-align:center}
      .vs-head td:first-child{text-align:left}
      .vs-row td{padding:12px 14px;font-size:14px;border-bottom:1px solid #f1f5f9;vertical-align:top}
      .vs-row td:first-child{font-weight:500;color:#334155}
      .dragon-col{background:#fff8f8}
      .win-col{background:#f8faff}
      .google-col{background:#f8fff8}
      .sub-col{background:#fffbf0}

      /* Content sections */
      .prose{max-width:820px}
      .prose h2{font-size:24px;letter-spacing:-0.02em;margin:0 0 12px}
      .prose p{font-size:15px;line-height:1.8;color:#334155;margin:0 0 16px}
      .prose ul{margin:0 0 16px;padding-left:24px}
      .prose li{font-size:15px;line-height:1.8;color:#334155;margin-bottom:4px}
      .two-col{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:24px}
      .info-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:22px}
      .info-card h3{margin:0 0 10px;font-size:17px}
      .info-card p{margin:0;font-size:14px;color:#475569;line-height:1.7}
      .info-card ul{margin:8px 0 0;padding-left:20px}
      .info-card li{font-size:14px;color:#475569;line-height:1.8}
      .verdict-badge{display:inline-block;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px}
      .verdict-dragon{background:#fde8e8;color:#991b1b}
      .verdict-free{background:#e0f2fe;color:#0c4a6e}
      .verdict-either{background:#fef3c7;color:#92400e}

      footer{background:#111;color:#64748b;padding:28px 0;font-size:14px}
      .footer-inner{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center}
      .footer-links{display:flex;gap:20px}
      .footer-links a:hover{color:white}
      .footer-disclaimer{font-size:11px;color:#475569;line-height:1.6;margin-top:12px;padding-top:12px;border-top:1px solid #222}

      @media(max-width:600px){
        .nav-links{display:none}
        .nav-ctas .btn-secondary{display:none}
        .hamburger{display:flex}
        section{padding:36px 0}
        .page-hero h1{font-size:26px}
        .two-col{grid-template-columns:1fr}
        .footer-inner{flex-direction:column;align-items:center;text-align:center}
        .footer-links{justify-content:center}
      }
    </style>
  </head>
  <body>

    <header>
      <div class="wrap">
        <div class="nav">
          <div class="logo">
            <a href="/"><img src="/logo.png" alt={site.siteName} onerror="this.style.display='none'" /></a>
          </div>
          <nav class="nav-links" aria-label="Primary">
            {site.navItems?.map((item) => <a href={homeUrl(item.url)}>{item.label}</a>)}
            {site.navDropdown && (
              <div class="dropdown">
                <span class="dropdown-toggle">
                  {site.navDropdown.label}
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </span>
                <div class="dropdown-menu">
                  {site.navDropdown.items?.map((item) => <a href={item.url}>{item.label}</a>)}
                </div>
              </div>
            )}
          </nav>
          <div class="nav-ctas">
            <a class="btn btn-primary" href="/#final-cta">{site.primaryCTA.text}</a>
            <button class="hamburger" aria-label="Open menu" onclick="var mn=this.closest('header').querySelector('.mobile-nav');mn.style.display=mn.style.display==='block'?'none':'block'">
              <span></span><span></span><span></span>
            </button>
          </div>
        </div>
        <nav class="mobile-nav" aria-label="Mobile navigation">
          <a href="/">Home</a>
          {site.navDropdown?.items?.map((item) => <a href={item.url}>{item.label}</a>)}
          {site.navItems?.map((item) => <a href={homeUrl(item.url)}>{item.label}</a>)}
        </nav>
      </div>
    </header>

    <main>

      <div class="page-hero">
        <div class="wrap">
          <div class="breadcrumb"><a href="/">Home</a> &rsaquo; Feature Comparison</div>
          <h1>Dragon Professional 16 - Full Feature Comparison</h1>
          <p>Compare all five Dragon Professional 16 licensing options side by side, then see how Dragon stacks up against free Windows tools and subscription-based alternatives. All information sourced from official Nuance documentation and Voice Recognition Australia.</p>
        </div>
      </div>

      <!-- SECTION 1: Version comparison table -->
      <section>
        <div class="wrap">
          <h2 style="font-size:26px;letter-spacing:-0.02em;margin:0 0 8px">Dragon Professional 16 - Version Comparison</h2>
          <p style="color:#475569;font-size:15px;margin:0">All five licensing options compared across features that matter to professional buyers.</p>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th class="feature-col" style="background:#f8fafc;border-bottom:2px solid #e2e8f0">Feature</th>
                  <th class="col-head">Perpetual<br/><span style="font-size:11px;font-weight:400;opacity:.85">$994 once</span></th>
                  <th class="col-head">Upgrade<br/><span style="font-size:11px;font-weight:400;opacity:.85">$495 once</span></th>
                  <th class="col-head featured">Subscription<br/><span style="font-size:11px;font-weight:400;opacity:.85">$595/yr</span></th>
                  <th class="col-head">Student<br/><span style="font-size:11px;font-weight:400;opacity:.85">$545 once</span></th>
                  <th class="col-head">Enterprise<br/><span style="font-size:11px;font-weight:400;opacity:.85">Enquire</span></th>
                </tr>
              </thead>
              <tbody>

                <tr class="section-head"><td colspan="6">Licensing and Installation</td></tr>
                <tr>
                  <td class="feature-col">Licence type</td>
                  <td class="val-col">Perpetual</td>
                  <td class="val-col">Perpetual</td>
                  <td class="val-col">Annual subscription</td>
                  <td class="val-col">Perpetual</td>
                  <td class="val-col">Volume / NMC managed</td>
                </tr>
                <tr>
                  <td class="feature-col">PC activations</td>
                  <td class="val-col">Up to 2</td>
                  <td class="val-col">Up to 2</td>
                  <td class="val-col">Unlimited</td>
                  <td class="val-col">Up to 2</td>
                  <td class="val-col">Managed via NMC</td>
                </tr>
                <tr>
                  <td class="feature-col">Licence delivery</td>
                  <td class="val-col">Licence key</td>
                  <td class="val-col">Licence key</td>
                  <td class="val-col">Username &amp; password</td>
                  <td class="val-col">Licence key</td>
                  <td class="val-col">NMC assigned</td>
                </tr>
                <tr>
                  <td class="feature-col">Activation wait</td>
                  <td class="val-col">Immediate</td>
                  <td class="val-col">Immediate</td>
                  <td class="val-col"><span class="partial">Up to 24 hrs</span></td>
                  <td class="val-col">Immediate</td>
                  <td class="val-col">Via IT / NMC</td>
                </tr>
                <tr>
                  <td class="feature-col">Eligible buyers</td>
                  <td class="val-col">Anyone</td>
                  <td class="val-col">v15 owners only</td>
                  <td class="val-col">Anyone</td>
                  <td class="val-col">Students / educators</td>
                  <td class="val-col">Organisations</td>
                </tr>

                <tr class="section-head"><td colspan="6">Core Dictation Features</td></tr>
                <tr>
                  <td class="feature-col">Real-time dictation (Windows apps)</td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                </tr>
                <tr>
                  <td class="feature-col">Works offline after activation</td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                </tr>
                <tr>
                  <td class="feature-col">Custom vocabulary</td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                </tr>
                <tr>
                  <td class="feature-col">AutoText (boilerplate shortcuts)</td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                </tr>
                <tr>
                  <td class="feature-col">Voice macros and commands</td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                </tr>
                <tr>
                  <td class="feature-col">Hands-free PC control</td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                </tr>
                <tr>
                  <td class="feature-col">Single-speaker transcription<span class="note">MP3, WAV, WMA, DS2, DSS</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                </tr>
                <tr>
                  <td class="feature-col">Multi-speaker / meeting transcription</td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                </tr>
                <tr>
                  <td class="feature-col">Mac support</td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                </tr>

                <tr class="section-head"><td colspan="6">Compatibility</td></tr>
                <tr>
                  <td class="feature-col">Windows 10 / 11</td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                </tr>
                <tr>
                  <td class="feature-col">Microsoft 365 / Office 2021</td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                </tr>
                <tr>
                  <td class="feature-col">Microsoft Teams dictation</td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                </tr>
                <tr>
                  <td class="feature-col">Google Docs dictation</td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                </tr>
                <tr>
                  <td class="feature-col">Citrix / Remote Desktop</td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                </tr>

                <tr class="section-head"><td colspan="6">Enterprise / IT Management</td></tr>
                <tr>
                  <td class="feature-col">Nuance Management Centre (NMC)</td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="partial">Compatible</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                </tr>
                <tr>
                  <td class="feature-col">Active Directory / SSO</td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                </tr>
                <tr>
                  <td class="feature-col">Central vocab / command distribution</td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                </tr>
                <tr>
                  <td class="feature-col">Usage reporting</td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                </tr>
                <tr>
                  <td class="feature-col">Volume licensing / licence reassignment</td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="cross">&#10005;</span></td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
                </tr>

                <tr class="section-head"><td colspan="6">Support and Trial</td></tr>
                <tr>
                  <td class="feature-col">15-day free trial</td>
                  <td class="val-col"><span class="check">&#10003;</span></td>
